# Copy to ../.env (the package root) and fill in. NEVER commit a real key.
PRIVATE_KEY=0xyour_testnet_private_key

# The reference deployment on StudioNet -- reads against it work out of the box.
CONTRACT_ADDRESS=0xCdfB0533aE689AD2D7da6875f3F4454Ce8DF38e4

# Used by deploy_and_create_vault.py when creating a fresh vault
BENEFICIARY_ADDRESS=0xbeneficiary_address

# Used by lifecycle_walkthrough.py / live_smoke_check.py
VAULT_OWNER=0xan_address_that_already_created_a_vault
STANDBY_SIGNER=0xoptional_second_key_allowed_to_check_in
GITHUB_HANDLE=octocat
X_HANDLE=octocat
WEBSITE_URL=https://example.com/octocat
IDENTITY_URL=https://identity.example.com/about

# Set to any non-empty value to make deploy_and_create_vault.py ATTACH to
# CONTRACT_ADDRESS instead of deploying a new copy.
USE_EXISTING=
